// Dispatch - Social Media Management Platform
// Powered by Keegareaux Labs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== User & Authentication ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?   // Hashed, nullable for OAuth-only users
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  clients       ClientMembership[]
  posts         Post[]

  @@index([email])
}

enum UserRole {
  ADMIN
  USER
  VIEWER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==================== Multi-tenant (Clients) ====================

model Client {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members        ClientMembership[]
  brands         Brand[]
  templates      Template[]
  subscriptionId String?  @unique
  subscription   Subscription?

  @@index([slug])
}

model ClientMembership {
  id       String @id @default(cuid())
  userId   String
  clientId String
  role     ClientRole @default(MEMBER)

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
}

enum ClientRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Subscription {
  id          String   @id @default(cuid())
  clientId    String   @unique
  plan        PlanType @default(FREE)
  status      SubscriptionStatus @default(ACTIVE)

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  // Limits
  maxBrands       Int @default(1)
  maxPosts        Int @default(10)
  maxSocialAccounts Int @default(3)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

enum PlanType {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
}

// ==================== Brand Profiles ====================

model Brand {
  id          String  @id @default(cuid())
  clientId    String
  name        String
  slug        String
  description String?
  logo        String?
  website     String?

  // Brand voice for AI (Voiceprint)
  brandVoice  String? @db.Text
  toneKeywords String[] // ["professional", "friendly", "witty"]
  targetAudience String?
  contentGoals String[] // ["engagement", "awareness", "conversions"]

  // Default hashtags and mentions
  defaultHashtags String[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client         Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  socialAccounts SocialAccount[]
  posts          Post[]

  @@unique([clientId, slug])
  @@index([clientId])
}

// ==================== Social Media Accounts (Channels) ====================

model SocialAccount {
  id               String   @id @default(cuid())
  brandId          String
  platform         SocialPlatform
  platformUserId   String   // Instagram/Facebook/LinkedIn user ID
  username         String
  displayName      String?
  avatar           String?

  // OAuth tokens
  accessToken      String   @db.Text
  refreshToken     String?  @db.Text
  tokenExpiresAt   DateTime?

  // Account metadata
  isActive         Boolean  @default(true)
  lastSyncedAt     DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  brand            Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  scheduledPosts   ScheduledPost[]

  @@unique([platform, platformUserId])
  @@index([brandId])
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
}

// ==================== Posts & Content ====================

model Post {
  id          String   @id @default(cuid())
  brandId     String
  userId      String   // Creator

  // Content
  caption     String   @db.Text
  imageUrl    String?
  imageKey    String?  // S3 key for deletion
  templateId  String?

  // AI metadata (Signal)
  aiGenerated Boolean  @default(false)
  aiPrompt    String?  @db.Text

  // Status
  status      PostStatus @default(DRAFT)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
  template    Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  scheduled   ScheduledPost[]

  @@index([brandId])
  @@index([userId])
  @@index([status])
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
  ARCHIVED
}

// ==================== Scheduling (Queue) ====================

model ScheduledPost {
  id              String   @id @default(cuid())
  postId          String
  socialAccountId String

  // Scheduling
  scheduledFor    DateTime
  publishedAt     DateTime?
  status          ScheduleStatus @default(PENDING)

  // Publishing metadata
  platformPostId  String?  // ID from Instagram/Facebook/LinkedIn
  errorMessage    String?  @db.Text
  retryCount      Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([scheduledFor, status])
  @@index([postId])
  @@index([socialAccountId])
}

enum ScheduleStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  CANCELLED
}

// ==================== Templates (Blueprints) ====================

model Template {
  id          String   @id @default(cuid())
  clientId    String?  // Null for global templates
  name        String
  description String?
  category    TemplateCategory

  // Template data
  thumbnailUrl String
  fileUrl      String   // S3 URL for PSD/AI/Figma file
  fileKey      String   // S3 key
  dimensions   Json     // { width: 1080, height: 1080 }

  // Usage
  isPublic     Boolean  @default(false)
  usageCount   Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  posts        Post[]

  @@index([clientId])
  @@index([category])
  @@index([isPublic])
}

enum TemplateCategory {
  INFOGRAPHIC
  QUOTE
  PROMOTION
  ANNOUNCEMENT
  STORY
  CAROUSEL
}

// ==================== AI Caption History (Signal) ====================

model CaptionGeneration {
  id          String   @id @default(cuid())
  userId      String
  brandId     String?

  // Input
  prompt      String   @db.Text
  imageUrl    String?
  brandVoice  String?  @db.Text

  // Output
  caption     String   @db.Text
  alternatives Json?   // Array of alternative captions

  // Metadata
  model       String   @default("claude-3-5-sonnet-20241022")
  tokensUsed  Int?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([brandId])
  @@index([createdAt])
}

// ==================== Analytics (Debrief - Future) ====================

model PostAnalytics {
  id              String   @id @default(cuid())
  scheduledPostId String   @unique

  // Engagement metrics
  likes           Int      @default(0)
  comments        Int      @default(0)
  shares          Int      @default(0)
  impressions     Int      @default(0)
  reach           Int      @default(0)

  // Metadata
  lastFetchedAt   DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([scheduledPostId])
}
